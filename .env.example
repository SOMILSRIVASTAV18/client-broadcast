# Render Backend Environment Variables (no secrets stored here)
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Set by Dockerfile (or point to system Chromium)
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Optional: Custom persistent storage paths (e.g. Render Persistent Disk at /var/data)
# WA_AUTH_PATH=/var/data/.wwebjs_auth
# WORKSPACE_DATA_PATH=/var/data/store.json

# Optional: Override Firebase Project ID or supply Firebase Service Account JSON
# FIREBASE_PROJECT_ID=leafy-brook-mwpgt
# FIREBASE_SERVICE_ACCOUNT_JSON=
